    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "cross-fetch": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "okx-api": "^3.1.3",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
