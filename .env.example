
# Use this file to set your environment variables
# Copy to .env and replace the values with your own

# Server Configuration
PORT=3333
NODE_ENV=development

# CoinMarketCap API
CMC_API_KEY=your_coinmarketcap_api_key_here
CMC_DEX_API_KEY=your_coinmarketcap_dex_api_key_here

# CORS (comma-separated list, leave empty to allow all origins)
ALLOWED_ORIGINS=

# Optional: SOCKS5 Proxy 
SOCKS5_AGENT=socks5://username:password@proxy-host:port

# Exchange API Keys - Bybit
KEY_BYBIT=your_bybit_api_key
SECRET_BYBIT=your_bybit_secret_key

# Exchange API Keys - OKX
KEY_OKX=your_okx_api_key
SECRET_OKX=your_okx_secret_key
PASS_OKX=your_okx_passphrase

# Exchange API Keys - Binance
KEY_BINANCE=your_binance_api_key
SECRET_BINANCE=your_binance_secret_key

# Exchange API Keys - Bitget
KEY_BITGET=your_bitget_api_key
SECRET_BITGET=your_bitget_secret_key
PASS_BITGET=your_bitget_passphrase

# Access Control for Balances Endpoint
ACCESS_KEY=your_secure_access_key_minimum_10_characters

# Optional: Session Cookies for Exchange Scraping (if needed)
# These cookies may need to be refreshed periodically
BYBIT_COOKIE=optional_bybit_session_cookie
OKX_COOKIE=optional_okx_session_cookie
OKX_AUTHORIZATION=optional_okx_authorization_token